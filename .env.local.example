# Copiá este archivo a .env.local (gitignorado, nunca se sube) y completá
# los valores reales. Las mismas variables van cargadas en Netlify:
# Site configuration > Environment variables > Add a variable.

# Supabase — Settings > API en tu proyecto de supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NUNCA se expone al navegador (por eso no lleva NEXT_PUBLIC_).
# Bypassea RLS por completo — solo se usa en Route Handlers/Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para armar los links de tracking de WhatsApp en
# los emails). En local: http://localhost:3000. En producción:
# https://capacitaciones.escencialconsultora.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo — la cuenta principal (fila 'Cuenta principal' en brevo_accounts,
# env_var_name = 'BREVO_API_KEY_1'). Si en el futuro se agregan más
# cuentas para la rotación, van como BREVO_API_KEY_2, BREVO_API_KEY_3...
BREVO_API_KEY_1=

# Cifra las API keys que se guardan desde el Panel de Integraciones.
# Generá con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca regenerar una vez que haya alguna clave real guardada.
SECRETS_ENCRYPTION_KEY=

# Puerta de entrada al panel admin (ver middleware.ts) — /admin directo
# devuelve 404 sin sesión activa; se entra por /<este-valor>/login.
# Generá con: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_SECRET_PATH=

# Protege la función background que realmente manda los emails
# pendientes (netlify/functions/process-pending-emails-background.ts)
# de que cualquiera la dispare a mano si adivina la URL — la función
# programada (send-pending-emails.ts) la llama pasando este mismo valor.
# Generá con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_FUNCTION_SECRET=
