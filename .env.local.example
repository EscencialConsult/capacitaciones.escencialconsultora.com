# Copiá este archivo a .env.local (gitignorado, nunca se sube) y completá
# los valores reales. Las mismas variables van cargadas en Netlify:
# Site configuration > Environment variables > Add a variable.

# Supabase — Settings > API en tu proyecto de supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NUNCA se expone al navegador (por eso no lleva NEXT_PUBLIC_).
# Bypassea RLS por completo — solo se usa en Route Handlers/Server Actions.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (para armar los links de tracking de WhatsApp en
# los emails). En local: http://localhost:3000. En producción:
# https://capacitaciones.escencialconsultora.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo — la cuenta principal (fila 'Cuenta principal' en brevo_accounts,
# env_var_name = 'BREVO_API_KEY_1'). Si en el futuro se agregan más
# cuentas para la rotación, van como BREVO_API_KEY_2, BREVO_API_KEY_3...
BREVO_API_KEY_1=
